# https://dev.mu.social - deploys on push to eurosky/dev. For other branches,
# run "Deploy web" from the Actions tab and pick the dev environment.

DEPLOY_URL=https://dev.mu.social

# Disallow-all robots.txt so dev stays out of search.
ROBOTS_MODE=disallow-all

# Own OAuth client, assertions from the shared non-prod worker (see
# staging.env).
EXPO_PUBLIC_OAUTH_BASE_URL=https://dev.mu.social
EXPO_PUBLIC_OAUTH_ASSERTION_URL=https://oauth-staging.mu.social/client-assertion

# Unregistered in Plausible, so dev traffic never pollutes prod stats.
EXPO_PUBLIC_PLAUSIBLE_DOMAIN=dev.mu.social

# Unlike staging and production, sports is not forced off here.
EXPO_PUBLIC_FOOTBALLDATA_API_URL=https://sports.mu.social/v4

# News hub, against the Dutch labeler's tech instance (staging uses .dev).
EXPO_PUBLIC_DUTCH_API_URL=https://news.eurosky.tech
EXPO_PUBLIC_DUTCH_API_SERVICE_DID=did:plc:oub2sr5miponqkvdf3awv5qn
EXPO_PUBLIC_ENABLE_NEWS_V2=true
