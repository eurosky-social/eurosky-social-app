# Isolated Oso partner demo (brands/oso/). Manual only, never runs on push.
# scripts/build-oso-preview.sh hard-codes the Oso identity (host, OAuth,
# Plausible site, text scale, robots, metrics/shadow/sports off) on top of this.

DEPLOY_URL=https://oso.social
DEPLOY_BRAND=oso
# bunny_edge_setup.sh matches mu.social URLs; configure Oso's zone by hand.
DEPLOY_BUNNY_EDGE_SETUP=false

# Read by scripts/build-oso-preview.sh (these are also its defaults).
OSO_HOST=oso.social
OSO_OAUTH_ASSERTION_URL=https://oauth.oso.social/client-assertion

# The news page's location picker and labeler stories need both; without them
# the page falls back to RSS and the world only.
# news.eurosky.tech answers service JWTs for the same DID as the first
# instance (news-aggregator.eurosky.dev), so only the URL moves.
EXPO_PUBLIC_DUTCH_API_URL=https://news.eurosky.tech
EXPO_PUBLIC_DUTCH_API_SERVICE_DID=did:plc:oub2sr5miponqkvdf3awv5qn
EXPO_PUBLIC_ENABLE_NEWS_V2=true
