# https://oso.social - Oso partner demo, built from the oso branch, where
# src/config/brand.json carries the Oso brand. Manual only, never runs on push.

DEPLOY_URL=https://oso.social
DEPLOY_BRAND=oso
# bunny_edge_setup.sh matches mu.social URLs; configure Oso's zone by hand.
DEPLOY_BUNNY_EDGE_SETUP=false

# Not public yet: disallow-all robots.txt (web/index.html also has noindex).
ROBOTS_MODE=disallow-all

# Oso's own pinned assertion worker (services/oauth/bunny/index.ts) signs with
# the key in src/config/oauth.public-jwks.json. Its CLIENT_ID / ALLOWED_ORIGIN
# must match this base URL.
EXPO_PUBLIC_OAUTH_BASE_URL=https://oso.social
EXPO_PUBLIC_OAUTH_ASSERTION_URL=https://oauth.oso.social/client-assertion

EXPO_PUBLIC_PLAUSIBLE_DOMAIN=oso.social

# Signed-out visitors get the sign-in splash instead of the public feed, and
# small/medium body text is scaled up.
EXPO_PUBLIC_PARTNER_PREVIEW=1
EXPO_PUBLIC_THEME_BODY_SCALE=1.1
# Neither the shadow-read probe nor sports belongs in a demo.
EXPO_PUBLIC_APPVIEW_SHADOW_PERCENTAGE=0
EXPO_PUBLIC_ENABLE_SPORTS=false

# The news page's location picker and labeler stories need both; without them
# the page falls back to RSS and the world only.
# news.eurosky.tech answers service JWTs for the same DID as the first
# instance (news-aggregator.eurosky.dev), so only the URL moves.
EXPO_PUBLIC_DUTCH_API_URL=https://news.eurosky.tech
EXPO_PUBLIC_DUTCH_API_SERVICE_DID=did:plc:oub2sr5miponqkvdf3awv5qn
EXPO_PUBLIC_ENABLE_NEWS_V2=true
