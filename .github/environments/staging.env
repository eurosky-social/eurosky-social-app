# https://staging.mu.social - deployed on every push to eurosky/fork, against
# the production AT Protocol network. Search noindexing is also handled at the
# pull zone (Edge Rule adds X-Robots-Tag: noindex, nofollow).

DEPLOY_URL=https://staging.mu.social

# Disallow-all robots.txt so staging stays out of search.
ROBOTS_MODE=disallow-all

# Staging is its own atproto OAuth client: client_id derives from this base
# URL (gen-oauth-metadata.js self-publishes /oauth-client-metadata.json).
# Assertions come from the shared non-prod worker (services/oauth/bunny/
# staging.ts), which derives the client_id from the request Origin and so
# serves every *.mu.social environment. Prod has its own pinned worker.
EXPO_PUBLIC_OAUTH_BASE_URL=https://staging.mu.social
EXPO_PUBLIC_OAUTH_ASSERTION_URL=https://oauth-staging.mu.social/client-assertion

# Deliberately NOT the prod Plausible site: unregistered in Plausible, so
# events are accepted and discarded and never pollute prod stats.
EXPO_PUBLIC_PLAUSIBLE_DOMAIN=staging.mu.social

# Seasonal sports module is currently retired.
EXPO_PUBLIC_ENABLE_SPORTS=false
# Shares the prod live-sports proxy (read-only and cached).
EXPO_PUBLIC_FOOTBALLDATA_API_URL=https://sports.mu.social/v4

# The news hub reads the Dutch labeler's consumer API. Neither value is a
# secret: the DID is public, and reads use the signed-in user's service-auth
# token. EXPO_PUBLIC_ENABLE_NEWS_V2 serves the hub instead of the original
# news pages and needs both; production leaves it unset. Use the same API
# instance as the Oso deployment; its service-auth audience DID is unchanged.
EXPO_PUBLIC_DUTCH_API_URL=https://news.eurosky.tech
EXPO_PUBLIC_DUTCH_API_SERVICE_DID=did:plc:oub2sr5miponqkvdf3awv5qn
EXPO_PUBLIC_ENABLE_NEWS_V2=true
