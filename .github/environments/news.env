# https://news.mu.social - light-testing deployment of the news product.
# Run "Deploy web" manually with the news environment and the desired branch.
# Inherits shared Mu services from common.env, not the dev News V2 backend.

DEPLOY_URL=https://news.mu.social
EXPO_PUBLIC_PRODUCT=news

# Keep the preview out of search. This does not make the site private.
ROBOTS_MODE=disallow-all

# Separate OAuth identity, using the existing shared subdomain assertion worker.
EXPO_PUBLIC_OAUTH_BASE_URL=https://news.mu.social
EXPO_PUBLIC_OAUTH_ASSERTION_URL=https://oauth-staging.mu.social/client-assertion

# Keep test traffic separate from mu.social analytics.
EXPO_PUBLIC_PLAUSIBLE_DOMAIN=news.mu.social

# The current edge preset assumes the apex host and blocks some machine UAs.
# Configure the news zone's SPA routing/cache separately before using it.
DEPLOY_BUNNY_EDGE_SETUP=false
