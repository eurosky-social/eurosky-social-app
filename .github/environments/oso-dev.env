# https://dev.oso.social - manual only: run "Deploy web" from any branch with
# the oso-dev environment, to try a branch without touching oso.social. Same
# build as oso.env, only the host differs.

DEPLOY_URL=https://dev.oso.social
DEPLOY_BRAND=oso
# bunny_edge_setup.sh matches mu.social URLs; configure Oso's zone by hand.
DEPLOY_BUNNY_EDGE_SETUP=false

ROBOTS_MODE=disallow-all

# Own OAuth client. Oso's non-prod assertion worker (services/oauth/bunny/
# staging.ts with ALLOWED_PARENT_DOMAIN=oso.social) serves any *.oso.social
# subdomain and derives the client ID from the Origin, signing with the same
# Oso key as oauth.oso.social. The apex stays on that pinned prod worker.
EXPO_PUBLIC_OAUTH_BASE_URL=https://dev.oso.social
EXPO_PUBLIC_OAUTH_ASSERTION_URL=https://oauth-staging.oso.social/client-assertion

# Kept apart from oso.social's stats.
EXPO_PUBLIC_PLAUSIBLE_DOMAIN=dev.oso.social

# Same flags as oso.env.
EXPO_PUBLIC_PARTNER_PREVIEW=1
EXPO_PUBLIC_THEME_BODY_SCALE=1.1
EXPO_PUBLIC_APPVIEW_SHADOW_PERCENTAGE=0
EXPO_PUBLIC_ENABLE_SPORTS=false

# Same news hub as oso.env.
EXPO_PUBLIC_DUTCH_API_URL=https://news.eurosky.tech
EXPO_PUBLIC_DUTCH_API_SERVICE_DID=did:plc:oub2sr5miponqkvdf3awv5qn
EXPO_PUBLIC_ENABLE_NEWS_V2=true
