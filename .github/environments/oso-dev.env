# Oso dev (brands/oso/) at dev.oso.social. Manual only: run "Deploy web" from
# any branch with the oso-dev environment, to try a branch without touching
# oso.social. Same build as oso.env, only the host differs.

DEPLOY_URL=https://dev.oso.social
DEPLOY_BRAND=oso
# bunny_edge_setup.sh matches mu.social URLs; configure Oso's zone by hand.
DEPLOY_BUNNY_EDGE_SETUP=false

# Read by scripts/build-oso-preview.sh. The host drives share links, og:url,
# the OAuth client ID and redirect, and the Plausible site (dev.oso.social,
# kept apart from oso.social's stats).
OSO_HOST=dev.oso.social
# Oso's non-prod assertion worker (services/oauth/bunny/staging.ts with
# ALLOWED_PARENT_DOMAIN=oso.social): it serves any *.oso.social subdomain and
# derives the client ID from the Origin, signing with the same Oso key as
# oauth.oso.social. The apex stays on that pinned prod worker.
OSO_OAUTH_ASSERTION_URL=https://oauth-staging.oso.social/client-assertion

# Same news hub as oso.env.
EXPO_PUBLIC_DUTCH_API_URL=https://news.eurosky.tech
EXPO_PUBLIC_DUTCH_API_SERVICE_DID=did:plc:oub2sr5miponqkvdf3awv5qn
EXPO_PUBLIC_ENABLE_NEWS_V2=true
