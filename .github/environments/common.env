# Build-time settings shared by every web environment. Loaded first by
# scripts/web_build.sh; <environment>.env is loaded on top and wins.
#
# Shell syntax (sourced with `set -a`): KEY=value, no spaces around `=`.
# Nothing in here is a secret - secrets live in the GitHub environment.

# Geolocation decides which regional moderation labelers are required; without
# it the app fail-closes and subscribes ALL of them. Served first-party from
# Bunny (see services/geolocation/), not ip.bsky.app, and it serves any origin.
EXPO_PUBLIC_ENABLE_GEOLOCATION=true
EXPO_PUBLIC_GEOLOCATION_URL=https://ip.mu.social

EXPO_PUBLIC_ENABLE_LIVE_EVENTS=false
EXPO_PUBLIC_ENABLE_APP_CONFIG=false

# Product-analytics events otherwise POST to events.bsky.app. Disabled.
EXPO_PUBLIC_ENABLE_METRICS=false

# First-party Bunny proxy for Plausible (see services/plausible/). Needs the
# scheme: the tracker posts to ${API_HOST}/api/event. The site itself
# (EXPO_PUBLIC_PLAUSIBLE_DOMAIN) is per environment.
EXPO_PUBLIC_PLAUSIBLE_API_HOST=https://events.mu.social

# First-party CORS proxy for newsroom RSS and article metadata. Public,
# read-only, and shared by every environment.
EXPO_PUBLIC_RSS_PROXY_URL=https://rss.mu.social

# Tiles (src/features/tiles/). A tile's resources come through the blob CDN
# (services/tiles/), which serves them from Bunny's edge by CID instead of
# from each author's PDS for every viewer. Empty would mean the PDS.
EXPO_PUBLIC_TILES_BLOB_URL=https://tiles.mu.social
# The tile loading server (services/tileLoader/): tiles run on throwaway
# origins it mints, <random>.t.mu.social. These are also the app's built-in
# defaults, which is what the native builds use.
EXPO_PUBLIC_TILES_LOAD_DOMAIN=load.t.mu.social
# The page the native apps' WebView runs a tile in; web builds do not use it.
EXPO_PUBLIC_TILES_HOST_URL=https://t.mu.social/host/

# Deploy settings read by scripts/web_build.sh and the workflow, not the app.
# DEPLOY_BRAND: mu builds the repo as-is; oso runs scripts/build-oso-preview.sh.
DEPLOY_BRAND=mu
# Apply scripts/bunny_edge_setup.sh after upload. Its rules match mu.social
# URLs, so only Mu zones should run it.
DEPLOY_BUNNY_EDGE_SETUP=true
# Prod-style robots.txt unless an environment opts out (see bunny_build.sh).
ROBOTS_MODE=prod
