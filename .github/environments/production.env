# https://mu.social - deployed on every push to eurosky/deploy.

DEPLOY_URL=https://mu.social

# OAuth: no override, so brand.json's prod client (oauth.mu.social) is used.

EXPO_PUBLIC_PLAUSIBLE_DOMAIN=mu.social

# Seasonal sports module is currently retired.
EXPO_PUBLIC_ENABLE_SPORTS=false
# First-party Bunny proxy for the live sports widget (see
# services/footballData/). Holds the football-data.org token server-side.
EXPO_PUBLIC_FOOTBALLDATA_API_URL=https://sports.mu.social/v4

# Temporary pre-cutover validation: copy 10% of eligible Bluesky AppView reads
# to api.eurosky.network and discard the response.
EXPO_PUBLIC_APPVIEW_SHADOW_PERCENTAGE=10
