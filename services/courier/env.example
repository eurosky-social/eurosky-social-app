# Bearer keys the AppView may call with, comma-separated. More than one lets a
# key be rotated without restarting both sides at once.
COURIER_API_KEYS=change-me

COURIER_DATABASE_URL=postgres://courier:password@localhost:5432/courier

# Listener. Keep it on loopback: the AppView and its dataplane are the only
# callers. COURIER_HTTP_VERSION must match BSKY_COURIER_HTTP_VERSION on them.
COURIER_HOST=127.0.0.1
COURIER_PORT=2587
COURIER_HTTP_VERSION=1.1

# App ids that may register. On iOS the app id is also the APNs topic.
COURIER_APP_IDS=social.mu.app

# Apple Push Notification service, token-based (.p8) key.
COURIER_APNS_KEY_FILE=/etc/courier/apns.p8
COURIER_APNS_KEY_ID=ABC123DEFG
COURIER_APNS_TEAM_ID=TEAM123456
# production (TestFlight and App Store builds) or sandbox (development builds)
COURIER_APNS_ENVIRONMENT=production

# Firebase Cloud Messaging, Google service account key file (JSON).
COURIER_FCM_SERVICE_ACCOUNT_FILE=/etc/courier/fcm-service-account.json

# Optional tuning (defaults shown).
# COURIER_GENERIC_TITLE=mu
# COURIER_GENERIC_MESSAGE=You have a new notification
# COURIER_TTL_SECONDS=86400
# COURIER_SEND_CONCURRENCY=64
# COURIER_MAX_QUEUED_SENDS=100000
# LOG_LEVEL=info
