    },
    "defaultAccent": "purple"
  },
  "oauth": {
    "$comment": "scope = what NEW logins request (keep transitional-only so every PDS accepts it). declaredScope = superset advertised in client metadata (must cover step-ups like identity:handle AND any scope older cached bundles still request). See src/config/oauth.ts.",
    "defaultBaseUrl": "https://oso.social",
    "clientName": "oso",
    "scope": "atproto transition:generic transition:email transition:chat.bsky",
    "declaredScope": "atproto transition:generic transition:email transition:chat.bsky identity:handle account:email?action=manage account:status?action=manage",
    "handleResolver": "https://bsky.social",
    "signupPdsHost": "https://pds.oso.social"
  },
  "links": {
    "tos": "https://oso.social/about/terms.html",
    "privacy": "https://oso.social/about/privacy.html",
