  "socialHandle": "",
  "colors": {
    "neutral": {
      "contrast_0": "#F1F1EF",
      "contrast_25": "#EAEAE7",
      "contrast_50": "#E3E3DF",
      "contrast_100": "#D9D9D4",
      "contrast_200": "#C5C4BF",
      "contrast_300": "#ABAAA6",
      "contrast_400": "#92918E",
      "contrast_500": "#797876",
      "contrast_600": "#62615F",
