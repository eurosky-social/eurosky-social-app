      "contrast_800": "#353535",
      "contrast_900": "#2A2A2A",
      "contrast_950": "#14141F",
      "contrast_975": "#101019",
      "contrast_1000": "#0C0C15"
    },
    "neutralSubduedOverrides": {
      "contrast_900": "#20202C",
