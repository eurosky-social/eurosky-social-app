    "supportRequest": "mailto:support@oso.social",
    "download": "https://bsky.app/download",
    "statusPage": "https://status.bsky.app/",
    "donate": "https://doneer.waag.org/oso",
    "feedback": "https://userinput.app/s/did:plc:crzflbsprcjobktyhtjdated/3myfscso2qe2w"
  },
  "services": {
